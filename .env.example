# ============================================================
# Gold Price Alert Bot - Environment Configuration
# ============================================================

# --- Gold API ---
# Get free key at: https://www.goldapi.io/
GOLD_API_KEY=your_goldapi_key_here

# --- Alert Thresholds ---
# Default percentage change to trigger alert
ALERT_THRESHOLD_PERCENT=1

# Specific thresholds per asset (optional, overrides default)
THRESHOLD_XAU=0.5
THRESHOLD_BTC=3
THRESHOLD_ETH=3

# --- Polling Interval ---
# How often to check price in minutes (default: 5)
POLL_INTERVAL_MINUTES=5

# --- Periodic Report ---
# Send a report every X hours even if no fluctuation
HOURLY_REPORT=2

# --- Symbols to track ---
SYMBOLS=XAU,BTC,ETH
# --- Notification Channels (set to "true" to enable) ---

# Console (always enabled)
NOTIFY_CONSOLE=true

# Telegram Bot
NOTIFY_TELEGRAM=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Webhook (POST JSON payload to URL)
NOTIFY_WEBHOOK=false
WEBHOOK_URL=https://your-webhook-url.com/gold-alert

# --- Logging ---
LOG_LEVEL=info   # debug | info | warn | error
